
import tkinter as tk
from tkinter import messagebox
import json

FILE_NAME = "tasks.json"

# List to store tasks
tasks = []


# Function to load tasks from file
def load_tasks():
    global tasks

    try:
        with open(FILE_NAME, "r", encoding="utf-8") as file:
            tasks = json.load(file)

        if not isinstance(tasks, list):
            tasks = []

    except (FileNotFoundError, json.JSONDecodeError):
        tasks = []


# Function to save tasks to file
def save_tasks():
    try:
        with open(FILE_NAME, "w", encoding="utf-8") as file:
            json.dump(tasks, file, indent=4, ensure_ascii=False)
    except OSError as error:
        messagebox.showerror("File Error", str(error))


# Function to display tasks
def display_tasks():
    task_list.delete(0, tk.END)

    for index, task in enumerate(tasks):
        if task["completed"]:
            text = "✓  " + task["title"] + "  [Completed]"
            task_list.insert(tk.END, text)
            task_list.itemconfig(index, fg="#16a34a")
        else:
            text = "○  " + task["title"] + "  [Pending]"
            task_list.insert(tk.END, text)
            task_list.itemconfig(index, fg="#26324a")

    total = len(tasks)
    completed = sum(1 for task in tasks if task["completed"])
    pending = total - completed

    total_label.config(text=f"Total Tasks: {total}")
    status_label.config(
        text=f"Completed: {completed}  |  Pending: {pending}"
    )


# Function to add a task
def add_task():
    title = task_entry.get().strip()

    if not title:
        messagebox.showwarning("Warning", "Please enter a task!")
        return

    tasks.append({
        "title": title,
        "completed": False
    })

    task_entry.delete(0, tk.END)

    save_tasks()
    display_tasks()


# Function to mark a task complete or pending
def complete_task():
    selected = task_list.curselection()

    if not selected:
        messagebox.showwarning("Warning", "Please select a task!")
        return

    index = selected[0]
    tasks[index]["completed"] = not tasks[index]["completed"]

    save_tasks()
    display_tasks()


# Function to delete a task
def delete_task():
    selected = task_list.curselection()

    if not selected:
        messagebox.showwarning("Warning", "Please select a task!")
        return

    index = selected[0]

    if messagebox.askyesno("Confirm", "Do you want to delete this task?"):
        tasks.pop(index)
        save_tasks()
        display_tasks()


